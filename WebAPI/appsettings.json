{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PharmacyDepotDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "CacheSettings": {
    "ExpirationTime": 7
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "PharmacyDepot_"
  },
  "SeriLogConfigurations": {
    "FileLogConfiguration": {
      "FolderPath": "Logs"
    },
    "MssqlLogConfiguration": {
      "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=PharmacyDepotDb;Trusted_Connection=True;MultipleActiveResultSets=true",
      "TableName": "Logs",
      "AutoCreateSqlTable": true
    }
  },
  "AllowedHosts": "*"
}
